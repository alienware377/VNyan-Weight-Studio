<Project Sdk="Microsoft.NET.Sdk">

  <!--
    IDE / IntelliSense project for the Weight Studio Reader plugin DLL.

    The CANONICAL build path is build_vnobj.bat. This .csproj only exists for
    editor autocomplete / error-checking and is not required to ship the plugin.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>VNyanWeightStudioReader</AssemblyName>
    <RootNamespace>VNyanWeightStudioReader</RootNamespace>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);_unitybuild\**;dist\**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup>
    <!-- your VNyan folder (the one with VNyan.exe inside). Set it here, with
         dotnet build -p:VNyanDir="...", or through the VNYAN environment variable
         (the build scripts read that one too). -->
    <VNyanDir Condition="'$(VNyanDir)' == ''">$(VNYAN)</VNyanDir>
    <VNyanManaged>$(VNyanDir)\VNyan_Data\Managed</VNyanManaged>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="UnityEngine"><HintPath>$(VNyanManaged)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(VNyanManaged)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AnimationModule"><HintPath>$(VNyanManaged)\UnityEngine.AnimationModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(VNyanManaged)\UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AssetBundleModule"><HintPath>$(VNyanManaged)\UnityEngine.AssetBundleModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Collections"><HintPath>$(VNyanManaged)\Unity.Collections.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.SharedInternalsModule"><HintPath>$(VNyanManaged)\UnityEngine.SharedInternalsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(VNyanManaged)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(VNyanManaged)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(VNyanManaged)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule"><HintPath>$(VNyanManaged)\UnityEngine.UnityWebRequestModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VNyanInterface"><HintPath>$(VNyanManaged)\VNyanInterface.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
