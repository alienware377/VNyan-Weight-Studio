<Project Sdk="Microsoft.NET.Sdk">

  <!--
    IDE / IntelliSense project for the Weight Studio Reader plugin DLL.

    The CANONICAL build path is build_vnobj.bat. This .csproj only exists for
    editor autocomplete / error-checking and is not required to ship the plugin.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>VNyanWeightStudioReader</AssemblyName>
    <RootNamespace>VNyanWeightStudioReader</RootNamespace>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);_unitybuild\**;dist\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="UnityEngine"><HintPath>C:\Program Files\VNyan\VNyan_Data\Managed\UnityEngine.dll</HintPath><Private>false</Private></Reference>
