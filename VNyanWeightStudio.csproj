<Project Sdk="Microsoft.NET.Sdk">

  <!--
    IDE / IntelliSense project for the Weight Studio plugin DLL.

    The CANONICAL build path is build_vnobj.bat (Unity's Roslyn compiler against
    VNyan's own managed DLLs, then a .vnobj AssetBundle). This .csproj exists so
    Visual Studio / Rider can give you red squiggles and autocomplete; it is not
    required to ship the plugin.

    Point the HintPaths below at the DLLs in your VNyan install. Referencing
    everything in VNyan_Data\Managed guarantees version-correct UnityEngine.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>VNyanWeightStudio</AssemblyName>
    <RootNamespace>VNyanWeightStudio</RootNamespace>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Exclude the Unity build project and staged output from this compile. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);_unitybuild\**;dist\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="UnityEngine"><HintPath>C:\Program Files\VNyan\VNyan_Data\Managed\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>C:\Program Files\VNyan\VNyan_Data\Managed\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AnimationModule"><HintPath>C:\Program Files\VNyan\VNyan_Data\Managed\UnityEngine.AnimationModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>C:\Program Files\VNyan\VNyan_Data\Managed\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>C:\Program Files\VNyan\VNyan_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>C:\Program Files\VNyan\VNyan_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>C:\Program Files\VNyan\VNyan_Data\Managed\UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Collections"><HintPath>C:\Program Files\VNyan\VNyan_Data\Managed\Unity.Collections.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.SharedInternalsModule"><HintPath>C:\Program Files\VNyan\VNyan_Data\Managed\UnityEngine.SharedInternalsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>C:\Program Files\VNyan\VNyan_Data\Managed\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>C:\Program Files\VNyan\VNyan_Data\Managed\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>C:\Program Files\VNyan\VNyan_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>C:\Program Files\VNyan\VNyan_Data\Managed\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VNyanInterface"><HintPath>C:\Program Files\VNyan\VNyan_Data\Managed\VNyanInterface.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
